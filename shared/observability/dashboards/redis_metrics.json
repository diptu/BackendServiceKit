{
  "title": "Redis Metrics",
  "description": "Panels 1-3 (Redis Command Rate, Cache Hit Ratio, Redis p95 Latency) have no real backing data today — cache_operation_duration_seconds / cache_hits_total / cache_misses_total are shared/observability/metrics/{counters,histograms}.py OTel constructors never called anywhere in Tenent/APIGateway (see services/MetricsCollection/TODO.md Decision #1). Panel 4 (Isolation Decisions/s) IS real — it's Tenent's own isolation_decisions_total, scraped directly under job=\"tenent\" — it's just misplaced in a dashboard titled 'Redis Metrics' (apparent copy-paste residue); left in place rather than relocated to avoid scope creep on a cleanup pass.",
  "uid": "redis-metrics",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Redis Command Rate (ops/s)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "sum(rate(cache_operation_duration_seconds_count[5m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Cache Hit Ratio (%)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "100 * sum(rate(cache_hits_total[5m])) by (service) / (sum(rate(cache_hits_total[5m])) by (service) + sum(rate(cache_misses_total[5m])) by (service))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "id": 3,
      "title": "Redis p95 Latency (ms)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "histogram_quantile(0.95, sum(rate(cache_operation_duration_seconds_bucket[5m])) by (le, service)) * 1000",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ms"}}
    },
    {
      "id": 4,
      "title": "Isolation Decisions/s (real — job=tenent, misplaced here)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "sum(rate(isolation_decisions_total{job=\"tenent\"}[5m])) by (decision)",
          "legendFormat": "{{decision}}"
        }
      ]
    }
  ]
}
