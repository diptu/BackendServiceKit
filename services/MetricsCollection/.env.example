# Metrics Collection service environment variables
APP_NAME=nutratenant-metrics-collection
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# Prometheus — system of record for scraped/pulled metrics (this service
# never stores scraped metrics itself)
PROMETHEUS_BASE_URL=http://localhost:9090
PROMETHEUS_TIMEOUT=10.0

# Pushgateway — system of record for pushed metrics (POST /metrics, /metrics/bulk)
PUSHGATEWAY_BASE_URL=http://localhost:9091
PUSHGATEWAY_TIMEOUT=10.0
METRICS_BULK_MAX_ITEMS=500

SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_AUTH_ENABLED=false

CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:8080"]

ENABLE_METRICS=true
ENABLE_TRACING=false
OTLP_ENDPOINT=http://localhost:4317
HEALTHCHECK_TIMEOUT_SECONDS=5
