APP_NAME=nutratenant-user-lifecycle-management
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/nutratenant_user_lifecycle
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30

# Upstream — the underlying user record this service orchestrates
# transitions for lives in UserManagement, not here.
USER_MANAGEMENT_BASE_URL=http://localhost:8023
USER_MANAGEMENT_TIMEOUT=5.0

# Security
SECRET_KEY=CHANGE_ME

# CORS
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Observability
ENABLE_METRICS=true
ENABLE_TRACING=true
OTLP_ENDPOINT=http://localhost:4317

# Health Checks
HEALTHCHECK_TIMEOUT_SECONDS=5
