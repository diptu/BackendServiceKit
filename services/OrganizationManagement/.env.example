# OrganizationManagement service environment variables
APP_NAME=nutratenant-organization-management
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/nutratenant_organization
DATABASE_SSL=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30

SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_AUTH_ENABLED=false

# Synchronous validation that tenant_id refers to a real, active tenant —
# called once at organization-creation time only (not a live FK).
TENENT_BASE_URL=http://localhost:8005
TENENT_TIMEOUT=5.0

CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:8080"]

ENABLE_METRICS=true
ENABLE_TRACING=false
OTLP_ENDPOINT=http://localhost:4317
HEALTHCHECK_TIMEOUT_SECONDS=5
