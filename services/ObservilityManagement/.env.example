# ObservilityManagement — merged Logging+DistributedTracing+MetricsCollection
# +Monitoring+Alerting+Observability+HealthCheck service
APP_NAME=nutratenant-observability-management
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

SIBLING_TIMEOUT=5.0

# Tier-1 raw backends — one shared httpx client per backend
LOKI_BASE_URL=http://localhost:3100
TEMPO_BASE_URL=http://localhost:3200
PROMETHEUS_BASE_URL=http://localhost:9090
PUSHGATEWAY_BASE_URL=http://localhost:9091
ALERTMANAGER_BASE_URL=http://localhost:9093

# External services still out-of-process (unaffected by this merge)
TENENT_BASE_URL=http://localhost:8005
API_GATEWAY_BASE_URL=http://localhost:8080

# Alerting domain — managed alert-rule file (see TODO.md Decision #4-equivalent)
MANAGED_RULES_FILE_PATH=/data/rules/managed.yml
MANAGED_RULES_GROUP_NAME=alerting-service-managed
DEFAULT_ACKNOWLEDGE_MINUTES=240

# Observability domain — default lookback window for dashboard/anomaly composition
DEFAULT_WINDOW_MINUTES=15

SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_AUTH_ENABLED=false

CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:8080"]

ENABLE_METRICS=true
ENABLE_TRACING=false
OTLP_ENDPOINT=http://localhost:4317
HEALTHCHECK_TIMEOUT_SECONDS=5
