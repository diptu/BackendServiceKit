# Logging service environment variables
APP_NAME=nutratenant-logging
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# Loki — system of record for log storage (this service never stores logs itself)
LOKI_BASE_URL=http://localhost:3100
LOKI_TIMEOUT=10.0

SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_AUTH_ENABLED=false

# Bulk ingestion escape hatch (POST /logs, /logs/bulk) — not the primary ingestion
# path, which is stdout -> promtail -> Loki for every containerized service.
LOGS_BULK_MAX_ITEMS=500

CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:8080"]

ENABLE_METRICS=true
ENABLE_TRACING=false
OTLP_ENDPOINT=http://localhost:4317
HEALTHCHECK_TIMEOUT_SECONDS=5
