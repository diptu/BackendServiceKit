APP_NAME=nutratenant-user
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/nutratenant_user
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30

# Messaging — this service is the producer IAM's identity.events exchange
# has been waiting for since IAM's own build.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=identity.events

# Security
SECRET_KEY=CHANGE_ME

# CORS
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Observability
ENABLE_METRICS=true
ENABLE_TRACING=true
OTLP_ENDPOINT=http://localhost:4317

# Health Checks
HEALTHCHECK_TIMEOUT_SECONDS=5
