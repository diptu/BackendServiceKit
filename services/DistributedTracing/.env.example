# Distributed Tracing service environment variables
APP_NAME=nutratenant-distributed-tracing
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# Tempo — system of record for trace storage (this service never stores traces itself)
TEMPO_BASE_URL=http://localhost:3200
TEMPO_TIMEOUT=10.0

SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_AUTH_ENABLED=false

CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:8080"]

ENABLE_METRICS=true
ENABLE_TRACING=false
OTLP_ENDPOINT=http://localhost:4317
HEALTHCHECK_TIMEOUT_SECONDS=5
