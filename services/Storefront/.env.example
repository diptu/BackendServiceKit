APP_NAME=nutratenant-storefront
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Control-plane / default database (used by Alembic + readiness probe)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/nutratenant_storefront

# Physical silo (database-per-tenant). ON by default: each shop's data lives in
# its own database, resolved per request from X-Tenant-ID. {tenant_id} is
# substituted at runtime; migrate per-tenant DBs with scripts/tenant_migrations.py.
SILOED_MULTITENANCY_ENABLED=true
TENANT_RESOLVER=template
TENANT_DATABASE_URL_TEMPLATE=postgresql+asyncpg://postgres:postgres@localhost:5433/storefront_{tenant_id}

# Messaging
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=storefront.events

# Security
SECRET_KEY=CHANGE_ME

# CORS
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# Observability
ENABLE_METRICS=true
ENABLE_TRACING=true
OTLP_ENDPOINT=http://localhost:4317

# Health Checks
HEALTHCHECK_TIMEOUT_SECONDS=5
