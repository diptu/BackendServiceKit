APP_NAME=nutratenant-api-gateway
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Redis — DB 3 for response cache, DB 4 for Celery broker, DB 5 for Celery results
REDIS_URL=redis://localhost:6379/3
REDIS_TENANT_CACHE_TTL=300
REDIS_LIFECYCLE_CACHE_TTL=60

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=api-gateway.events
RABBITMQ_TENANT_EVENTS_EXCHANGE=tenant.events
RABBITMQ_TENANT_EVENTS_QUEUE=api-gateway.tenant-events

# Celery (uses RabbitMQ as broker)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672/
CELERY_RESULT_BACKEND=redis://localhost:6379/5

# Upstream services
TENENT_BASE_URL=http://localhost:8005
TENANT_PROVISIONING_BASE_URL=http://localhost:8003
OBSERVABILITY_MANAGEMENT_BASE_URL=http://localhost:8020
ORGANIZATION_MANAGEMENT_BASE_URL=http://localhost:8021
REDIS_TENENT_CACHE_TTL=300
REDIS_ISOLATION_CACHE_TTL=60
REDIS_PROVISIONING_CACHE_TTL=30
UPSTREAM_TIMEOUT=30.0

# Kong API Gateway
KONG_ADMIN_URL=http://localhost:8001
KONG_ENABLED=true

SECRET_KEY=CHANGE_ME

CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:8005","http://localhost:8003"]

ENABLE_METRICS=true
ENABLE_TRACING=true
OTLP_ENDPOINT=http://localhost:4317

# Health check
HEALTHCHECK_TIMEOUT_SECONDS=5
