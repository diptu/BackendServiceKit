# Observability service environment variables
APP_NAME=nutratenant-observability
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

SIBLING_TIMEOUT=5.0

# The six composed services — see TODO.md Decision #1: this service only
# ever calls their already-public REST APIs, never a tier-1 backend
# (Loki/Tempo/Prometheus/Alertmanager/Pushgateway) directly.
LOGGING_BASE_URL=http://localhost:8006
DISTRIBUTED_TRACING_BASE_URL=http://localhost:8007
METRICS_COLLECTION_BASE_URL=http://localhost:8008
MONITORING_BASE_URL=http://localhost:8009
ALERTING_BASE_URL=http://localhost:8010
HEALTH_CHECK_BASE_URL=http://localhost:8011

# Default lookback window for dashboard/anomaly composition
DEFAULT_WINDOW_MINUTES=15

SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_AUTH_ENABLED=false

CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:8080"]

ENABLE_METRICS=true
ENABLE_TRACING=false
OTLP_ENDPOINT=http://localhost:4317
HEALTHCHECK_TIMEOUT_SECONDS=5
