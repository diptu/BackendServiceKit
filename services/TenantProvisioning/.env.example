DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/nutratenant_provisioning
ENVIRONMENT=development
# Physical provisioning backend: local (sqlite files) or postgres (CREATE DATABASE)
PROVISIONER_BACKEND=local
# ADMIN_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/postgres
TENANT_DATABASE_URL_TEMPLATE=postgresql+asyncpg://postgres:postgres@localhost:5433/tenant_{tenant}
CONTROL_PLANE_BASE_URL=http://localhost:8005
CONTROL_PLANE_REGISTER_ENABLED=true
